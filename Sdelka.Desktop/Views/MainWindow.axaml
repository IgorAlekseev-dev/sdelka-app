<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sdelka.Desktop.ViewModels"
        xmlns:entities="using:Sdelka.Domain.Entities"
        x:Class="Sdelka.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Сделка — Безопасные объявления"
        Width="1060" Height="740"
        MinWidth="460" MinHeight="520"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- 1. Верхняя панель -->
        <Border Grid.Row="0" Padding="20,14" BorderThickness="0,0,0,1" BorderBrush="#F2F1F0">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <TextBlock Grid.Column="0"
                           Text="Сделка"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#000000"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="📍" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentUser.City}" FontSize="14" Foreground="#000000" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#F2F1F0" CornerRadius="14" Padding="10,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="14" Height="14" Fill="#FFB021" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentUser.Balance, StringFormat='{}{0:N0} ₽'}"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#000000"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F2F1F0" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser.FullName}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#000000"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Поисковик и категории -->
        <StackPanel Grid.Row="1" Margin="20,16,20,8" Spacing="14">

            <Grid ColumnDefinitions="Auto, *">
                <Button Grid.Column="0"
                        Content="Все категории"
                        Click="OnAllCategoriesClick"
                        Background="#00AAFF"
                        Foreground="#FFFFFF"
                        FontSize="14"
                        FontWeight="SemiBold"
                        CornerRadius="12"
                        Padding="16,11"
                        Margin="0,0,10,0"
                        Cursor="Hand"/>

                <Border Grid.Column="1"
                        BorderBrush="#00AAFF"
                        BorderThickness="2"
                        CornerRadius="12"
                        Background="#FFFFFF">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText}"
                                 PlaceholderText="Поиск по объявлениям"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#000000"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"
                                 Padding="12,8"/>

                        <Button Grid.Column="1"
                                Content="Найти"
                                Click="OnSearchClick"
                                Background="#00AAFF"
                                Foreground="#FFFFFF"
                                FontSize="14"
                                FontWeight="SemiBold"
                                CornerRadius="9"
                                Padding="20,9"
                                Margin="2"
                                Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="entities:Category">
                        <Button Content="{Binding Name}"
                                Click="OnCategoryClick"
                                Background="#F2F1F0"
                                Foreground="#000000"
                                FontSize="14"
                                CornerRadius="16"
                                Padding="16,10"
                                Margin="0,0,8,8"
                                Cursor="Hand"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 3. Объявления -->
        <ScrollViewer Grid.Row="2" Padding="14,4,14,20">
            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="entities:Product">
                        <Border Width="230" Background="#FFFFFF" CornerRadius="14" Margin="6">
                            <StackPanel Spacing="6">

                                <Border Height="185" Background="#F2F1F0" CornerRadius="14" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="📦"
                                                   FontSize="44"
                                                   Opacity="0.35"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <Border Background="#80000000"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="10"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="#FFFFFF"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="4,2,4,8" Spacing="3">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               Foreground="#000000"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} ₽'}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#000000"/>

                                    <TextBlock FontSize="13" Foreground="#757575">
                                        <Run Text="📍 "/>
                                        <Run Text="{Binding City}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding WeightKg}"/>
                                        <Run Text=" кг"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</Window>